# ==========================================================================
# StockPilot AI - Frontend Environment Variables
# Copy to `.env` for local development. Vite only exposes variables
# prefixed with VITE_ to client-side code.
# ==========================================================================

# --- FastAPI backend base URL (includes /api/v1 prefix) ---
# Development:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Production example:
# VITE_API_BASE_URL=https://your-production-api.com/api/v1

# --- Supabase project (same project the backend is configured against) ---
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

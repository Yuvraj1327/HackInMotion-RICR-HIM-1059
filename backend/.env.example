# ==========================================================================
# StockPilot AI - Backend Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ==========================================================================

# --- Supabase Project URL ---
# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
# Used by the backend to talk to your Supabase Postgres + Auth instance.
SUPABASE_URL=https://your-project-ref.supabase.co

# --- Supabase Anon (public) key ---
# Found in Supabase Dashboard -> Project Settings -> API -> anon public key
# Safe to expose to a browser client, but the backend uses it for
# operations that should respect Row Level Security (RLS) as a given user.
SUPABASE_ANON_KEY=your-anon-key

# --- Supabase Service Role key ---
# Found in Supabase Dashboard -> Project Settings -> API -> service_role key
# FULL ADMIN ACCESS - bypasses RLS. Backend-only. NEVER send this to the
# React frontend, never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase JWT secret ---
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
# Used by the backend to locally verify (decode + validate signature of)
# the JWT that Supabase Auth issues to logged-in users.
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Frontend URL ---
# The origin of the React app, used to configure CORS allow-list.
# Multiple origins can be comma-separated.
FRONTEND_URL=http://localhost:5173

# --- Environment ---
# One of: development | production
ENVIRONMENT=development
